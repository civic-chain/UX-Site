{
  "name": "civicchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:how-diagram": "node scripts/how-diagram/build.mjs",
    "start": "next start",
    "clean:local": "rm -rf .next .coverage .playwright-cli .playwright-mcp playwright-report test-results output tests/visual/__results__ .ignore/test-results .ignore/playwright-report .ignore/output tsconfig.tsbuildinfo .DS_Store public/.DS_Store components/.DS_Store _docs/.DS_Store _ops/.DS_Store public/brand/.DS_Store",
    "check": "npm run check:static && npm run check:policy",
    "check:static": "npm run lint:eslint && npm run lint:types && npm run lint:css",
    "check:policy": "npm run check:design-system && npm run check:assets && npm run check:instructions",
    "check:design-system": "npm run check:design-system:policy && npm run check:design-system:fixtures && npm run check:design-system:sync",
    "check:design-system:policy": "node scripts/checks/design-system/policy.mjs",
    "check:design-system:fixtures": "node scripts/checks/design-system/fixtures.mjs",
    "check:design-system:sync": "node scripts/checks/design-system/sync.mjs",
    "check:assets": "node scripts/checks/runtime-assets.mjs",
    "check:instructions": "node scripts/checks/instruction-drift.mjs",
    "lint": "npm run check",
    "lint:eslint": "eslint",
    "lint:types": "tsc --noEmit --pretty false --incremental false",
    "lint:design-system": "npm run check:design-system:policy",
    "lint:design-fixtures": "npm run check:design-system:fixtures",
    "lint:design-assets": "npm run check:assets",
    "lint:design-sync": "npm run check:design-system:sync",
    "lint:instructions": "npm run check:instructions",
    "lint:css": "stylelint \"app/**/*.css\"",
    "test:visual": "playwright test",
    "test:visual:brand": "playwright test tests/visual/brand-contracts.spec.ts",
    "test:visual:routes": "playwright test tests/visual/landing-contracts.spec.ts tests/visual/live-route-design-system.spec.ts tests/visual/marketing-pages.spec.ts tests/visual/surface-safety.spec.ts",
    "test:visual:list": "playwright test --list",
    "test:visual:ui": "playwright test --ui"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "material-symbols": "^0.45.1",
    "postcss": "^8.5.10",
    "postcss-value-parser": "^4.2.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3"
  }
}
